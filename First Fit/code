#include <stdio.h>

int main() {
    int b[20], p[20], nb, np, i, j;
    printf("Blocks: "); scanf("%d", &nb);
    printf("Processes: "); scanf("%d", &np);

    for(i=0;i<nb;i++) scanf("%d",&b[i]);
    for(i=0;i<np;i++) scanf("%d",&p[i]);

    for(i=0;i<np;i++){
        for(j=0;j<nb;j++)
            if(b[j] >= p[i]){
                printf("P%d -> B%d\n", i+1, j+1);
                b[j] -= p[i];
                break;
            }
        if(j==nb) printf("P%d -> Not Allocated\n", i+1);
    }
}
