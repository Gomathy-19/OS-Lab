#include <stdio.h>

int main() {
    int b[20], p[20], nb, np, i, j, best;
    printf("Blocks: "); scanf("%d",&nb);
    printf("Processes: "); scanf("%d",&np);

    for(i=0;i<nb;i++) scanf("%d",&b[i]);
    for(i=0;i<np;i++) scanf("%d",&p[i]);

    for(i=0;i<np;i++){
        best = -1;
        for(j=0;j<nb;j++)
            if(b[j] >= p[i] && (best==-1 || b[j] < b[best]))
                best = j;

        if(best!=-1){
            printf("P%d -> B%d\n", i+1, best+1);
            b[best] -= p[i];
        }
        else printf("P%d -> Not Allocated\n", i+1);
    }
}
