#include <stdio.h>

int main() {
    int b[20], p[20], nb, np, i, j, worst;
    printf("Blocks: "); scanf("%d",&nb);
    printf("Processes: "); scanf("%d",&np);

    for(i=0;i<nb;i++) scanf("%d",&b[i]);
    for(i=0;i<np;i++) scanf("%d",&p[i]);

    for(i=0;i<np;i++){
        worst = -1;
        for(j=0;j<nb;j++)
            if(b[j] >= p[i] && (worst==-1 || b[j] > b[worst]))
                worst = j;

        if(worst!=-1){
            printf("P%d -> B%d\n", i+1, worst+1);
            b[worst] -= p[i];
        }
        else printf("P%d -> Not Allocated\n", i+1);
    }
}
